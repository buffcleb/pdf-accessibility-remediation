# Copy to .env. Every value has a safe default; nothing here is host-specific except the dev Ollama URL.

# --- service ---
# SERVICE_API_KEY=change-me            # if set, callers must send X-API-Key
# PUBLIC_BASE_URL=https://pdf-api.example.com   # prefix for download URLs (default: relative)
MAX_UPLOAD_MB=200
JOB_TTL_HOURS=24
TASK_TIME_LIMIT_S=3600

# --- remediation ---
DEFAULT_LANGUAGE=en-US
VERAPDF_FLAVOURS=ua1,ua2               # first = primary verdict
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_ENGINE=tesseract                 # tesseract (command line: word confidence, AI correction) or pymupdf
OCR_AI_ENABLED=true                  # the AI corrects OCR words Tesseract was unsure of (needs the tesseract command)
OCR_AI_MIN_CONF=80                   # words below this confidence may be corrected
OCR_AI_TRANSCRIBE_BELOW=45           # lines with mean confidence below this are read afresh by the AI
OCR_AI_MAX_LINES=300                 # per document, most uncertain first
RASTER_DPI=200

# --- AI providers ---
AI_CONCURRENCY=4
AI_TIMEOUT_S=180
AI_NOTATION_ENABLED=true             # the AI reads math/chemistry/medical/engineering notation the layout rules can't
AI_NOTATION_MAX=100                  # regions per document
ALLOW_MOCK_PROVIDER=false              # true only for tests/harness: mock alt text is placeholder text

OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o
OPENROUTER_TABLE_MODEL=anthropic/claude-3.5-sonnet
# The kind-of-document classifier ("Let AI decide") uses this key with Jev (OpenRouter's System One API)
CLASSIFIER_JEV_MODEL=jev-1.13

# Dev: Ollama running on the Docker host
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=qwen3-vl:8b
OLLAMA_THINK=off                 # off is ~3x faster for qwen3-vl / gemma4; on can help hard charts

LOCALAI_BASE_URL=http://host.docker.internal:8080/v1
LOCALAI_DEFAULT_MODEL=qwen3-vl-8b-instruct
LOCALAI_REASONING_EFFORT=none     # turns off thinking (gemma 4 / qwen3) so answers are not empty
# OLLAMA_NUM_CTX=8192                 # raise context for models that support it (llava:13b is 4096)

# --- tag verification (runs on every output) ---
VERIFY_ENABLED=true
VERIFY_AI_ENABLED=true
# The judge should be a different model family from the generator above.
VERIFY_JUDGE_PROVIDER=ollama
VERIFY_JUDGE_MODEL=gemma4:26b
VERIFY_SAMPLE_RATE=0.10          # unflagged figures also reviewed (flag full_review=true reviews all)
VERIFY_AI_MAX_ITEMS=150
VERIFY_AI_READING_ORDER=false    # local models misjudged correct orders in testing; enable with a validated cloud judge
# Per-content-type judges, JSON. Keys: default, chart, diagram, formula, handwriting, sheet_music,
# screenshot, logo, photo, illustration, reading_order.
# VERIFY_ROUTES={"chart": {"provider": "openrouter", "model": "anthropic/claude-opus-5.5"}}

# --- Adobe PDF Services Autotag (route "adobe"; the portal's "Adobe Autotag" service) ---
# Off unless switched on. Documents sent this way go to Adobe. Adobe doesn't publish its limits, so set
# them from your contract. For local testing without an Adobe account, run the fake Adobe server
# (docker compose --profile fake-adobe up -d fake-adobe) and point ADOBE_BASE_URL at http://fake-adobe:8090
# with any client id and secret.
ADOBE_ENABLED=false
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_BASE_URL=https://pdf-services-ue1.adobe.io   # EU: https://pdf-services-ew1.adobe.io
ADOBE_RPM=25                     # API requests per minute, shared by every Adobe worker
ADOBE_MAX_CONCURRENT=2           # documents (or parts) at Adobe at once, shared by every Adobe worker
ADOBE_MAX_RETRIES=4              # for throttling and server errors; running out of transactions isn't retried
ADOBE_MAX_PAGES_PER_CALL=100     # larger documents are split, tagged in parts and merged back
ADOBE_MAX_MB_PER_CALL=100
ADOBE_POLL_SECONDS=3
ADOBE_TIMEOUT_MINUTES=20         # per part
ADOBE_GENERATE_REPORT=true       # keep Adobe's own accessibility report (xlsx) with the job
ADOBE_WORKER_CONCURRENCY=2

# --- OpenRouter profiles (see README "Using OpenRouter"); keep generator and judge in different families ---
# Same models as local, hosted:   OPENROUTER_DEFAULT_MODEL=qwen/qwen3-vl-32b-instruct  VERIFY_JUDGE_MODEL=google/gemma-4-31b-it
# Quality:                        OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-5.5  VERIFY_JUDGE_MODEL=google/gemini-3.8-flash
# Budget:                         OPENROUTER_DEFAULT_MODEL=google/gemini-3.1-flash-lite VERIFY_JUDGE_MODEL=openai/gpt-5.4-nano

# ---------------------------------------------------------------------------------------------
# Portal API (docker-compose.portal.yml). Generate the key and secret with:
#   .venv/bin/python -m portal.cli genkeys
# ---------------------------------------------------------------------------------------------
PORTAL_JWT_PRIVATE_KEYS=
PORTAL_SECRET_KEY=
# Emails that become super admins on first sign-in
PORTAL_BOOTSTRAP_SUPER_ADMINS=you@example.edu
# Browser origin(s) of the web app, comma-separated; the API refuses cookie requests from others
PORTAL_CORS_ORIGINS=http://localhost:5173
PORTAL_APP_URL=http://localhost:5173
# Set true behind HTTPS (always in production)
PORTAL_COOKIE_SECURE=false
# Email: smtp | ses | plunk | cloudflare | console (log only). The sender name can be changed in
# Administration -> Settings -> Branding; the address must be on a domain the provider has verified.
PORTAL_MAIL_BACKEND=smtp
PORTAL_MAIL_FROM=PDF Remediation <no-reply@example.org>
# PORTAL_MAIL_REPLY_TO=help@example.org
# PORTAL_MAIL_ATTEMPTS=3                 # tries for temporary failures
# smtp (any relay; Cloudflare's SMTP submission is smtp.mx.cloudflare.net:465 with SMTP_SSL=true)
# PORTAL_SMTP_HOST=smtp.example.org
# PORTAL_SMTP_PORT=587
# PORTAL_SMTP_STARTTLS=true
# PORTAL_SMTP_SSL=false
# PORTAL_SMTP_USERNAME=
# PORTAL_SMTP_PASSWORD=
# ses (credentials from the AWS environment variables or the machine's role)
# PORTAL_SES_REGION=us-east-1
# PORTAL_SES_CONFIGURATION_SET=
# plunk
# PORTAL_PLUNK_API_KEY=sk_...
# PORTAL_PLUNK_BASE_URL=https://next-api.useplunk.com
# cloudflare (Email Service REST API; sender address only, no display name)
# PORTAL_CLOUDFLARE_ACCOUNT_ID=
# PORTAL_CLOUDFLARE_API_TOKEN=
# Set true only when a trusted proxy (Cloudflare, ALB, nginx) sets the client IP headers
PORTAL_TRUST_PROXY_HEADERS=false
# Interactive API docs at /api/v1/docs (leave off in production)
PORTAL_ENABLE_DOCS=false
# Object storage (any S3 API). Empty endpoint = AWS S3.
PORTAL_S3_ENDPOINT_URL=
PORTAL_S3_BUCKET=pdf-remediation
PORTAL_S3_ACCESS_KEY=
PORTAL_S3_SECRET_KEY=
# Remediation engine (internal network only) and the AI provider it should use for portal jobs
PORTAL_ENGINE_URL=http://engine-api:8000
# The AI gateway's admin UI as super admins' browsers reach it (linked from Administration; empty hides it)
PORTAL_GATEWAY_ADMIN_URL=http://localhost:4000/ui
PORTAL_ENGINE_API_KEY=
PORTAL_ENGINE_AI_PROVIDER=localai
PORTAL_ENGINE_AI_MODEL=
PORTAL_ENGINE_MAX_IN_FLIGHT=4

# ---------------------------------------------------------------------------------------------
# AI gateway (LiteLLM, docker-compose.yml service "litellm", models in config/litellm.yaml)
# ---------------------------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-change-me            # admin key for LiteLLM itself; starts with sk-
LITELLM_DB_PASSWORD=change-me
# Sign-in for the gateway's admin UI (http://localhost:4000/ui); the master key also works
UI_USERNAME=admin
UI_PASSWORD=change-me
# Local OpenAI-compatible server (LocalAI, vLLM, Ollama's /v1) the local models run on
LOCAL_AI_BASE_URL=http://host.docker.internal:8080/v1
LOCAL_AI_API_KEY=none
LOCAL_VISION_MODEL=openai/qwen3-vl-8b-instruct
LOCAL_JUDGE_MODEL=openai/gemma-4-26b-a4b-it-qat-q4_0
# How the engine reaches the gateway. Use a LiteLLM virtual key (with its own budget) outside local testing.
GATEWAY_BASE_URL=http://litellm:4000/v1
GATEWAY_API_KEY=sk-change-me
GATEWAY_DEFAULT_MODEL=local-vision
# The review model through the gateway
# VERIFY_JUDGE_PROVIDER=gateway
# VERIFY_JUDGE_MODEL=local-judge

# ---------------------------------------------------------------------------------------------
# Backups (scripts/backup.sh and scripts/restore.sh; read from the shell environment, not by the services)
# ---------------------------------------------------------------------------------------------
# BACKUP_DIR=./backups                      # where backups go (or --out)
# BACKUP_AGE_RECIPIENT=age1...              # --encrypt-config with age (recommended); restore needs BACKUP_AGE_IDENTITY
# BACKUP_AGE_IDENTITY=/secure/backup-key.txt
# BACKUP_PASSPHRASE=                        # --encrypt-config with openssl when no age recipient is set
# BACKUP_S3_ENDPOINT_URL=                   # --upload to a non-AWS S3 service; empty for AWS
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY=                     # empty: the standard AWS variables or the machine's role
# BACKUP_S3_SECRET_KEY=
