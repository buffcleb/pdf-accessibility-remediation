# Portal settings for the local Compose stack (docker-compose.portal.yml). Copy to .env.portal and fill in.
# Every setting can also be set in the environment; see portal/config.py and docs/operations/configuration.md.

# Signing keys: generate a pair with  python -m portal.cli genkeys  (or the portal image:
#   docker compose -p portal -f docker-compose.portal.yml --env-file .env.portal run --rm --no-deps portal-api \
#     python -m portal.cli genkeys    (fill in PORTAL_S3_SSE_KEK below first: the Compose file requires it))
PORTAL_JWT_PRIVATE_KEYS=
PORTAL_SECRET_KEY=

# These addresses become super admins the first time they sign in (comma-separated)
PORTAL_BOOTSTRAP_SUPER_ADMINS=you@example.org

# Database and object store passwords (any long random strings; openssl rand -hex 24)
PORTAL_DB_PASSWORD=
PORTAL_S3_ACCESS_KEY=portal
PORTAL_S3_SECRET_KEY=
# SeaweedFS's key for encryption at rest: 32 random bytes as hex (openssl rand -hex 32)
PORTAL_S3_SSE_KEK=

# The engine (the other Compose stack, on this machine)
PORTAL_ENGINE_URL=http://host.docker.internal:8000
# Jobs without an AI level use this engine provider (gateway, or none)
PORTAL_ENGINE_AI_PROVIDER=gateway

# Mail: locally it goes to Mailpit (http://localhost:8025). See docs/operations/email-and-branding.md for real providers.
PORTAL_MAIL_BACKEND=smtp
PORTAL_MAIL_FROM=PDF Remediation <no-reply@example.org>

# Where people reach the app (cookies are HTTPS-only when PORTAL_COOKIE_SECURE=true)
PORTAL_APP_URL=http://localhost:8088
PORTAL_COOKIE_SECURE=false
