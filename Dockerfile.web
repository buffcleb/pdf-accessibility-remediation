# Web app: build the static files, then serve them with an unprivileged nginx that also proxies
# /api/ to the portal API (same origin, so no CORS and the refresh cookie stays first-party).
# Base images are pinned to a digest (the tag says which, the digest makes it that build and no other); the
# digests are those of 2026-10-13, and moving to a newer build is a deliberate change of this line.
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
# The build's id (scripts/build.sh passes the image tag): in the bundle and in /build.json, so pages open before a
# deploy load the new build when the person moves on
ARG WEB_BUILD_ID=""
RUN WEB_BUILD_ID="$WEB_BUILD_ID" npm run build

FROM nginxinc/nginx-unprivileged:1.31-alpine@sha256:378d0c32f6562f7fd9629170797f57d2b953aa09be983b3daaf4809bb039ca00
# Packages of the base image with a fixed vulnerability newer than its digest (scripts/build.sh's Trivy scan): libexpat
# (CVE-2026-77214, fixed in 2.9.0). Drop a package from the list once the pinned base image has the fix.
USER root
RUN apk upgrade --no-cache libexpat
USER 101
COPY docker/web/default.conf.template /etc/nginx/templates/default.conf.template
COPY --chmod=755 docker/web/15-trusted-proxies.sh /docker-entrypoint.d/15-trusted-proxies.sh
COPY --chmod=755 docker/web/16-grafana.sh /docker-entrypoint.d/16-grafana.sh
COPY --from=build /web/dist /usr/share/nginx/html
# TRUSTED_PROXIES: proxies in front of this container whose X-Forwarded-For is believed (empty: none)
# GRAFANA_UPSTREAM: Grafana for super admins at /grafana (MONITORING=on; empty: no /grafana)
ENV PORTAL_API_UPSTREAM=http://portal-api:8080 MAX_UPLOAD_SIZE=512m TRUSTED_PROXIES="" GRAFANA_UPSTREAM=""
EXPOSE 8080
