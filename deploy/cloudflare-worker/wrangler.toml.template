# Rendered by scripts/deploy-worker.sh into deploy/cloudflare-worker/wrangler.toml (not committed).
name = "${WORKER_NAME}"
main = "worker.js"
compatibility_date = "2025-09-01"
workers_dev = false
routes = [{ pattern = "${APP_HOST}", custom_domain = true }]

[assets]
directory = "../../web/dist"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = ["/api/*"]

[vars]
API_ORIGIN = "https://${API_ORIGIN_HOST}"
