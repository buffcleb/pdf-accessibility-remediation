# Cluster deployment settings for scripts/deploy.sh (copy to deploy/k8s/deploy.env; `scripts/deploy.sh init` does it).
# No secrets here: those are in deploy/k8s/engine.env and deploy/k8s/portal.env (also made by init, never committed).

# Which cluster: the kubeconfig to use, and optionally a context in it
KUBECONFIG_PATH=$HOME/.kube/config
KUBE_CONTEXT=

NAMESPACE=pdf-remediation
# The public address (Cloudflare tunnel -> ingress-nginx). Add the tunnel route for it on the Cloudflare side.
APP_HOST=pdf.example.org
# Where the web app is served from: "cluster" (the web pod; self-contained, the default) or "worker" (a Cloudflare
# Worker serves it from the edge and forwards /api/ to API_ORIGIN_HOST on the cluster: scripts/deploy-worker.sh)
FRONTEND=cluster
API_ORIGIN_HOST=pdf-origin.example.org
WORKER_NAME=pdf-remediation-web

# Images (scripts/build.sh pushes here; tags come from deploy/k8s/.last-build unless set here)
REGISTRY=ghcr.io/your-account
ENGINE_TAG=
PORTAL_TAG=
WEB_TAG=
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable

# Storage (both required). Databases, queues and stored files: a block storage class (a Retain reclaim policy keeps
# the volume if a claim is deleted). The engine's shared job folder: a ReadWriteMany class.
# For example: longhorn, ceph-rbd, gp3 (EKS), or a NAS's iSCSI class; and nfs-client, cephfs, longhorn (RWX), efs-sc
STORAGE_CLASS=
SHARED_STORAGE_CLASS=
DB_SIZE=10Gi
REDIS_SIZE=1Gi
FILES_SIZE=50Gi
JOBDATA_SIZE=50Gi

# Cloudflare tunnel: runs when deploy/k8s/tunnel.env has TUNNEL_TOKEN (see deploy/k8s/README.md)
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2025.7.0

# Engine capacity
ENGINE_WORKERS=1
WORKER_CONCURRENCY=2
WORKER_MEMORY_LIMIT=4Gi
ADOBE_WORKERS=0

# Largest upload through the web app and ingress. Cloudflare's own limit is 100 MB on Free and Pro plans.
MAX_UPLOAD_SIZE=100m
