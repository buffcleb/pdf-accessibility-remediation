# Cluster deployment settings for scripts/deploy.sh (copy to deploy/k8s/deploy.env; `scripts/deploy.sh init` does it).
# No secrets here: those are in deploy/k8s/engine.env and deploy/k8s/portal.env (also made by init, never committed).

# Which cluster:
# - KUBECONFIG_PATH: the kubeconfig to use.
# - KUBE_CONTEXT: a context in it; empty: its current context.
# - NAMESPACE: the namespace everything is deployed in.
KUBECONFIG_PATH=$HOME/.kube/config
KUBE_CONTEXT=
NAMESPACE=pdf-remediation

# The public address (Cloudflare tunnel -> ingress-nginx). Add the tunnel route for it on the Cloudflare side.
APP_HOST=pdf.example.org
# - FRONTEND: where the web app is served from: "cluster" (the web pod; self-contained, the default) or "worker" (a
#   Cloudflare Worker serves it from the edge and forwards /api/ to API_ORIGIN_HOST on the cluster:
#   scripts/deploy-worker.sh).
# - API_ORIGIN_HOST: with FRONTEND=worker, the address the Worker forwards /api/ to.
FRONTEND=cluster
API_ORIGIN_HOST=pdf-origin.example.org
# With FRONTEND=worker: where the ingress controller's traffic to the API origin comes from. RKE2's controller runs
# in the nodes' own network, so give the node network (for example 192.0.2.0/24); a controller that runs as a pod in
# kube-system needs nothing here. Unset, nothing is let in that way (81-api-origin-policy.yaml).
API_ORIGIN_SOURCE_CIDR=
# With FRONTEND=worker: the only sources allowed to reach the API origin, comma-separated: Cloudflare's published
# ranges (https://www.cloudflare.com/ips/). Required: anyone else could name themselves to the portal.
API_ORIGIN_ALLOWED_SOURCES=
# - TRUSTED_PROXY_CIDRS: the proxies whose header names the caller to the portal API (RKE2's pod range: cloudflared
#   and the web pod run there). Headers from anything else are ignored.
# - WORKER_NAME: with FRONTEND=worker, the Cloudflare Worker's name.
TRUSTED_PROXY_CIDRS=10.42.0.0/16
WORKER_NAME=pdf-remediation-web

# Images:
# - REGISTRY: where scripts/build.sh pushes the images and the cluster pulls them from.
# - ENGINE_TAG, PORTAL_TAG, WEB_TAG: the images' tags; from deploy/k8s/.last-build (written by scripts/build.sh)
#   unless set here.
REGISTRY=ghcr.io/your-account
ENGINE_TAG=
PORTAL_TAG=
WEB_TAG=
# A release of the gateway, pinned to its digest (what main-stable pointed at on 2026-10-13): moving it is a choice
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.105.0@sha256:60947db020b57e204823d3fbc8bb295c85be890d7c9adcc77fb4f5fc2fe410b2
# The AI gateway's admin UI isn't exposed by these manifests (use kubectl port-forward, in the README). If you
# publish it yourself behind your own access control, put its address here to link it for super admins in
# Administration; empty shows them how to reach it by port-forward instead.
GATEWAY_ADMIN_URL=
# The gateway's shared admin login (UI_USERNAME and UI_PASSWORD in engine.env). Turn it off once every admin has
# an account of their own in the gateway's UI (Internal Users), and has signed in with it: off leaves no other
# way in. To get back in, set it to on and deploy again.
GATEWAY_SHARED_LOGIN=on
# - VERAPDF_IMAGE: veraPDF kept running for the engine's PDF/UA checks (Docker Hub, amd64), pinned by digest.
# - CURL_IMAGE: the image of veraPDF's hourly restart job, pinned by digest.
VERAPDF_IMAGE=verapdf/rest:v1.30.2@sha256:341359ac6af558f35f03c355a798fec57ba049dd04f0a503f300170e1696573b
CURL_IMAGE=curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777

# Storage (both classes required). A size can go up later, and scripts/deploy.sh grows the volume; never down
# (docs/deployment/first-cluster/storage.md#growing-a-volume):
# - STORAGE_CLASS: for the databases, queues and stored files, a block storage class (a Retain reclaim policy keeps
#   the volume if a claim is deleted). For example longhorn, ceph-rbd, gp3 (EKS), or a NAS's iSCSI class.
# - SHARED_STORAGE_CLASS: for the engine's shared job folder, a ReadWriteMany class. For example nfs-client, cephfs,
#   longhorn (RWX), efs-sc.
# - DB_SIZE: the PostgreSQL volume (the portal's and the AI gateway's databases).
# - REDIS_SIZE: the Redis volume.
# - FILES_SIZE: the object store's volume (SeaweedFS: uploads and results).
# - JOBDATA_SIZE: the engine's shared job folder.
STORAGE_CLASS=
SHARED_STORAGE_CLASS=
DB_SIZE=10Gi
REDIS_SIZE=1Gi
FILES_SIZE=50Gi
JOBDATA_SIZE=50Gi

# Cloudflare tunnel: runs when deploy/k8s/tunnel.env has TUNNEL_TOKEN (see deploy/k8s/README.md)
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.0@sha256:9b49eed8f62806d5d45ddf59ecefb5710429598ea6d3fcccd2af938f621b2b07

# Engine capacity:
# - ENGINE_WORKERS: engine worker pods (the least, with scaling on).
# - WORKER_CONCURRENCY: documents each worker pod processes at once.
# - WORKER_MEMORY_LIMIT: each worker pod's memory limit.
# - VERAPDF_HEAP: the veraPDF service's Java heap.
# - VERAPDF_MEMORY_LIMIT: the veraPDF pod's memory limit: its heap plus about 300 MB.
# - VERAPDF_RESTART_SCHEDULE: when the veraPDF service restarts (cron, UTC).
# - ADOBE_WORKERS: Adobe Autotag worker pods; 0 until Adobe is set up (ADOBE_ENABLED and the client ID and secret
#   in engine.env).
ENGINE_WORKERS=1
WORKER_CONCURRENCY=2
WORKER_MEMORY_LIMIT=4Gi
VERAPDF_HEAP=512m
VERAPDF_MEMORY_LIMIT=1Gi
VERAPDF_RESTART_SCHEDULE="0 * * * *"
ADOBE_WORKERS=0

# Scaling with the work (manifests/45-autoscale.yaml):
# - AUTOSCALE: auto (on when the cluster has KEDA, https://keda.sh, and metrics-server), on, or off (fixed sizes:
#   ENGINE_WORKERS workers, one veraPDF, one AI gateway).
# - ENGINE_WORKERS_MAX: the most worker pods: one pod per WORKER_CONCURRENCY documents waiting or in progress, from
#   ENGINE_WORKERS up to this. Each document keeps about one CPU busy and a worker pod may use WORKER_MEMORY_LIMIT,
#   so size it to the nodes (3 nodes of 4 CPUs and 16 GiB: about 8 documents at once, 4 pods of 2).
# - VERAPDF_MAX: the most veraPDF pods.
# - LITELLM_MAX: the most AI gateway pods.
AUTOSCALE=auto
ENGINE_WORKERS_MAX=4
VERAPDF_MAX=3
LITELLM_MAX=2
# How long things must stay quiet before pods are removed (seconds)
SCALE_DOWN_SECONDS=600

# Malware scanning of uploads and help-desk attachments (#455): off (nothing scanned, and nothing extra runs), or
# clamav: a ClamAV pod (about 2 GB of memory, a 2 GB volume for its signatures, updates from database.clamav.net)
# that every upload is streamed to before it's stored. A file it finds malware in is refused and not kept; while it
# doesn't answer, every upload is refused. With it off, the CISO review records the risk accepted.
MALWARE_SCAN=off

# Music notation read note by note (Audiveris; manifests/36-music.yaml):
# - MUSIC_READER: off: each music example is one figure, described by the AI like any picture. on: its alt text is
#   a reading of the notes; build the image first with scripts/build.sh --only music. With scaling on, no pod runs
#   until a document has music (the first reading then waits for the pod to start); otherwise one pod is always
#   running.
# - MUSIC_MAX: the most music reader pods.
# - MUSIC_PER_POD: pictures waiting per pod.
# - MUSIC_MEMORY_LIMIT: each music reader pod's memory limit.
MUSIC_READER=off
MUSIC_MAX=2
MUSIC_PER_POD=4
MUSIC_MEMORY_LIMIT=2Gi
# How much music is read in one document, and how long the engine waits for the reader:
# - MUSIC_MAX_EXAMPLES: lines or examples in a document that has music in it (a textbook).
# - MUSIC_MAX_SCORE_LINES: lines in sheet music (most pages are music). About 6 seconds each on the cluster.
# - MUSIC_PER_MEASURE: a line that was read becomes one figure per measure (false: one per line).
# - MUSIC_WHOLE_SCORE: sheet music is also read as one piece, into a single MusicXML file, when its pages of
#   music are no more than MUSIC_WHOLE_SCORE_MAX_MB together.
# - MUSIC_WHOLE_SCORE_MAX_MB: the most a piece's pages of music may be, together, to be read as one piece.
# - MUSIC_WAIT_SECONDS: how long to wait for an answer (the first one includes the reader starting).
# - MUSIC_PAGE_SECONDS: for a whole piece, this much longer for each of its pages (the reader gets the same).
MUSIC_MAX_EXAMPLES=80
MUSIC_MAX_SCORE_LINES=600
MUSIC_PER_MEASURE=true
MUSIC_WHOLE_SCORE=true
MUSIC_WHOLE_SCORE_MAX_MB=40
MUSIC_WAIT_SECONDS=240
MUSIC_PAGE_SECONDS=90

# Formulas read a second time, from their pictures (manifests/37-formula.yaml, #403):
# - FORMULA_READER: off, or on (build the image first: scripts/build.sh --only formula). Each formula the AI read is
#   also read by a formula reader (RapidLaTeXOCR, free, about a second each on a CPU); where the two disagree, a
#   person chooses in Edit tag. With scaling on, no pod runs until a document has formulas.
# - FORMULA_MAX: the most formula reader pods.
# - FORMULA_PER_POD: pictures waiting per pod.
FORMULA_READER=off
FORMULA_MAX=2
FORMULA_PER_POD=20

# Behind an ingress controller (not Cloudflare): its pods' address range, so the web app passes on the caller's
# address from their X-Forwarded-For, not the controller's; and set PORTAL_CLIENT_IP_HEADER=x-forwarded-for in
# portal.env. Empty behind the Cloudflare tunnel, which reports the caller in its own header.
WEB_TRUSTED_PROXIES=

# HTTPS at your own ingress controller (leave empty behind the Cloudflare tunnel, which ends TLS itself):
# - CERT_ISSUER: a cert-manager ClusterIssuer that makes and renews APP_HOST's certificate (the Secret web-tls).
# - INGRESS_TLS_SECRET: instead, the name of a Secret in the namespace holding a certificate you put there yourself
#   (kubectl create secret tls), for example from the campus CA.
# - INGRESS_CONTROLLER: traefik (RKE2's default from v1.36) or nginx (ingress-nginx, retired upstream in March 2026;
#   RKE2's own build until it's removed). Traefik needs its entry points set once for the cluster: longer uploads
#   and HTTP sent on to HTTPS (docs/deployment/first-cluster/middleware.md).
# - INGRESS_CLASS: the controller's class, when it isn't the controller's usual one ("traefik", "nginx").
INGRESS_CONTROLLER=nginx
INGRESS_CLASS=
CERT_ISSUER=
INGRESS_TLS_SECRET=

# Outbound traffic from the portal, the AI gateway, the Adobe worker and ClamAV (#453, deploy/k8s/README.md): off
# (direct, as before), log (through the egress proxy, everything let through and each destination recorded) or
# enforce (only the hosts this deployment uses, and nothing round the proxy). Start with log, then enforce.
EGRESS_PROXY=off
# Other hosts to allow, comma-separated host or host:port (what the proxy's log showed in log mode)
EGRESS_ALLOW=
# The cluster's pod and service ranges, kept out of the proxy's reach
CLUSTER_CIDRS=10.42.0.0/16,10.43.0.0/16

# Outbound traffic from every other pod (#594, deploy/k8s/README.md):
# - EGRESS_DENY: off (as before: open) or on: nothing leaves the namespace unless a policy lets it, and each
#   workload reaches only what it uses (SeaweedFS, Postgres, the Redises and veraPDF only DNS; cloudflared
#   Cloudflare's edge; Prometheus the pods it reads, the kubelets and the Kubernetes API). The portal, the AI
#   gateway, the Adobe worker and ClamAV stay as EGRESS_PROXY makes them. To back out, set off and deploy.
# - NODE_CIDRS: With EGRESS_DENY=on, the nodes' addresses, comma-separated (kubectl get nodes -o wide), where
#   Prometheus reads each node's kubelet.
# - KUBE_API_CIDRS: The API servers' own addresses, when they aren't NODE_CIDRS (the kubernetes service's endpoints:
#   kubectl get endpointslice -n default -l kubernetes.io/service-name=kubernetes). deploy.sh checks them.
# - KUBE_API_PORT: The API servers' port at those addresses (RKE2's is 6443).
EGRESS_DENY=off
NODE_CIDRS=
KUBE_API_CIDRS=
KUBE_API_PORT=6443

# The pods that read uploaded documents on nodes of their own, away from the control plane and the databases (#471):
# a node label, key=value (pdfrem/role=engine). Label those nodes with it and taint them with it (key=value:NoSchedule)
# so nothing else runs there: docs/deployment/first-cluster/scaling.md. Empty: they run on any node.
ENGINE_NODES=

# The engine's own AI gateway key (#457, made by deploy.sh): what it may spend, in USD per 30 days, on top of the
# gateway's overall budget (config/litellm.yaml). Empty: no cap of its own.
GATEWAY_ENGINE_BUDGET=

# Traffic between the cluster's nodes (#452): deploy.sh checks it's encrypted (scripts/check_cluster_encryption.sh,
# read-only; WireGuard in Canal on RKE2) and shows the result before asking to go ahead. check: show it; require: stop
# when it isn't encrypted or can't be told (production); off: don't check.
NODE_ENCRYPTION=check

# Largest upload through the web app and ingress. Cloudflare's own limit is 100 MB on Free and Pro plans.
MAX_UPLOAD_SIZE=100m

# Backups (docs/operations/backups-and-migrations.md):
# - BACKUPS: cronjob, a nightly backup of both databases and the stored files onto an NFS share (a NAS shared
#   folder that allows NFS from every node, with users mapped so uid 10001 can write); the portal alerts super
#   admins when none has finished for a while (Settings > Alerts). Or external: the hosts' own backups (VM or
#   storage snapshots that cover the cluster's volumes) or none; no job, no backup alerts. scripts/backup.sh still
#   works by hand either way, and runs before every migration.
# - BACKUP_NFS_SERVER, BACKUP_NFS_PATH: with cronjob, the NFS share's server and exported path.
# - BACKUP_SCHEDULE, BACKUP_TIMEZONE: when the nightly backup runs (cron) and in which time zone.
# - BACKUP_KEEP_DAILY, BACKUP_KEEP_WEEKLY: how many daily and weekly backups are kept.
# - BACKUP_FILES: on also backs up the stored files (off: the databases only).
# - BACKUP_SIZE: the NFS share volume's nominal size, as Kubernetes records it.
# - BACKUP_NFS_VERSION: the NFS version the share is mounted with.
BACKUPS=external
BACKUP_NFS_SERVER=
BACKUP_NFS_PATH=
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_TIMEZONE=America/New_York
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_FILES=on
BACKUP_SIZE=20Gi
BACKUP_NFS_VERSION=4.1

# Monitoring (#397; docs/operations/monitoring.md): Prometheus, its alerts to super admins (email and Attention,
# with the portal's own), Administration > System's charts, and Grafana at https://APP_HOST/grafana/ for super
# admins (through the web app: FRONTEND=cluster). off removes them; their volumes stay.
# - PROMETHEUS_RETENTION: how much history is kept (15d, 8w, 1y). It's also cut to 85% of PROMETHEUS_SIZE, or to
#   PROMETHEUS_RETENTION_SIZE (e.g. 17GB) when set. This service needs well under 1 GB a week.
# - MONITORING_STORAGE_CLASS: for Prometheus's and Grafana's volumes; STORAGE_CLASS when empty.
# - MONITORING: on runs Prometheus, its alerts, Administration > System's charts and Grafana; off removes them
#   (their volumes stay).
# - PROMETHEUS_SIZE: Prometheus's volume.
# - PROMETHEUS_MEMORY_LIMIT: Prometheus's memory limit.
# - GRAFANA_SIZE: Grafana's volume.
# - VOLUME_ALERT_FREE_PERCENT: the "volume nearly full" alert fires when a volume has less than this percent free
#   for 30 minutes (1 to 90; 10 by default). Many campuses use 20.
MONITORING=on
PROMETHEUS_RETENTION=15d
PROMETHEUS_SIZE=20Gi
PROMETHEUS_MEMORY_LIMIT=2Gi
GRAFANA_SIZE=1Gi
MONITORING_STORAGE_CLASS=
VOLUME_ALERT_FREE_PERCENT=10
