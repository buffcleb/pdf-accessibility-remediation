# Cluster deployment settings for scripts/deploy.sh (copy to deploy/k8s/deploy.env; `scripts/deploy.sh init` does it).
# No secrets here: those are in deploy/k8s/engine.env and deploy/k8s/portal.env (also made by init, never committed).

# Which cluster: the kubeconfig to use, and optionally a context in it
KUBECONFIG_PATH=$HOME/.kube/config
KUBE_CONTEXT=

NAMESPACE=pdf-remediation
# The public address (Cloudflare tunnel -> ingress-nginx). Add the tunnel route for it on the Cloudflare side.
APP_HOST=pdf.example.org
# Where the web app is served from: "cluster" (the web pod; self-contained, the default) or "worker" (a Cloudflare
# Worker serves it from the edge and forwards /api/ to API_ORIGIN_HOST on the cluster: scripts/deploy-worker.sh)
FRONTEND=cluster
API_ORIGIN_HOST=pdf-origin.example.org
# With FRONTEND=worker: where the ingress controller's traffic to the API origin comes from. RKE2's controller runs
# in the nodes' own network, so give the node network (for example 192.0.2.0/24); a controller that runs as a pod in
# kube-system needs nothing here. Unset, nothing is let in that way (81-api-origin-policy.yaml).
API_ORIGIN_SOURCE_CIDR=
WORKER_NAME=pdf-remediation-web

# Images (scripts/build.sh pushes here; tags come from deploy/k8s/.last-build unless set here)
REGISTRY=ghcr.io/your-account
ENGINE_TAG=
PORTAL_TAG=
WEB_TAG=
# A release of the gateway, pinned to its digest (what main-stable pointed at on 2026-10-13): moving it is a choice
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.105.0@sha256:60947db020b57e204823d3fbc8bb295c85be890d7c9adcc77fb4f5fc2fe410b2
# The AI gateway's admin UI isn't exposed by these manifests (use kubectl port-forward, in the README). If you
# publish it yourself behind your own access control, put its address here to link it for super admins in
# Administration; empty shows them how to reach it by port-forward instead.
GATEWAY_ADMIN_URL=
# The gateway's shared admin login (UI_USERNAME and UI_PASSWORD in engine.env). Turn it off once every admin has
# an account of their own in the gateway's UI (Internal Users), and has signed in with it: off leaves no other
# way in. To get back in, set it to on and deploy again.
GATEWAY_SHARED_LOGIN=on
# veraPDF kept running for the engine's PDF/UA checks (Docker Hub, amd64), and the image of its hourly restart job
VERAPDF_IMAGE=verapdf/rest:v1.30.2@sha256:341359ac6af558f35f03c355a798fec57ba049dd04f0a503f300170e1696573b
CURL_IMAGE=curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777

# Storage (both required). Databases, queues and stored files: a block storage class (a Retain reclaim policy keeps
# the volume if a claim is deleted). The engine's shared job folder: a ReadWriteMany class.
# For example: longhorn, ceph-rbd, gp3 (EKS), or a NAS's iSCSI class; and nfs-client, cephfs, longhorn (RWX), efs-sc
STORAGE_CLASS=
SHARED_STORAGE_CLASS=
DB_SIZE=10Gi
REDIS_SIZE=1Gi
FILES_SIZE=50Gi
JOBDATA_SIZE=50Gi

# Cloudflare tunnel: runs when deploy/k8s/tunnel.env has TUNNEL_TOKEN (see deploy/k8s/README.md)
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.0@sha256:9b49eed8f62806d5d45ddf59ecefb5710429598ea6d3fcccd2af938f621b2b07

# Engine capacity
ENGINE_WORKERS=1
WORKER_CONCURRENCY=2
WORKER_MEMORY_LIMIT=4Gi
# veraPDF service: Java heap, the pod's memory limit (heap plus about 300 MB), and when it restarts (cron, UTC)
VERAPDF_HEAP=512m
VERAPDF_MEMORY_LIMIT=1Gi
VERAPDF_RESTART_SCHEDULE="0 * * * *"
ADOBE_WORKERS=0

# Scaling with the work (manifests/45-autoscale.yaml). auto: on when the cluster has KEDA (https://keda.sh) and
# metrics-server; on; or off (fixed sizes: ENGINE_WORKERS workers, one veraPDF, one AI gateway).
# Workers: one pod per WORKER_CONCURRENCY documents waiting or in progress, from ENGINE_WORKERS up to
# ENGINE_WORKERS_MAX. Each document keeps about one CPU busy and a worker pod may use WORKER_MEMORY_LIMIT, so size
# the maximum to the nodes (3 nodes of 4 CPUs and 16 GiB: about 8 documents at once, 4 pods of 2).
AUTOSCALE=auto
ENGINE_WORKERS_MAX=4
VERAPDF_MAX=3
LITELLM_MAX=2
# How long things must stay quiet before pods are removed (seconds)
SCALE_DOWN_SECONDS=600

# Music notation read note by note (Audiveris; manifests/36-music.yaml). off: each music example is one figure,
# described by the AI like any picture. on: its alt text is a reading of the notes; build the image first with
# scripts/build.sh --only music. With scaling on, no pod runs until a document has music (the first reading
# then waits for the pod to start); otherwise one pod is always running. MUSIC_PER_POD: pictures waiting per pod.
MUSIC_READER=off
MUSIC_MAX=2
MUSIC_PER_POD=4
MUSIC_MEMORY_LIMIT=2Gi
# How much music is read in one document, and how long the engine waits for the reader:
# - MUSIC_MAX_EXAMPLES: lines or examples in a document that has music in it (a textbook).
# - MUSIC_MAX_SCORE_LINES: lines in sheet music (most pages are music). About 6 seconds each on the cluster.
# - MUSIC_PER_MEASURE: a line that was read becomes one figure per measure (false: one per line).
# - MUSIC_WHOLE_SCORE: sheet music is also read as one piece, into a single MusicXML file, when its pages of
#   music are no more than MUSIC_WHOLE_SCORE_MAX_MB together.
# - MUSIC_WAIT_SECONDS: how long to wait for an answer (the first one includes the reader starting).
# - MUSIC_PAGE_SECONDS: for a whole piece, this much longer for each of its pages (the reader gets the same).
MUSIC_MAX_EXAMPLES=80
MUSIC_MAX_SCORE_LINES=600
MUSIC_PER_MEASURE=true
MUSIC_WHOLE_SCORE=true
MUSIC_WHOLE_SCORE_MAX_MB=40
MUSIC_WAIT_SECONDS=240
MUSIC_PAGE_SECONDS=90

# Behind an ingress controller (not Cloudflare): its pods' address range, so the web app passes on the caller's
# address from their X-Forwarded-For, not the controller's; and set PORTAL_CLIENT_IP_HEADER=x-forwarded-for in
# portal.env. Empty behind the Cloudflare tunnel, which reports the caller in its own header.
WEB_TRUSTED_PROXIES=

# Largest upload through the web app and ingress. Cloudflare's own limit is 100 MB on Free and Pro plans.
MAX_UPLOAD_SIZE=100m
