server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size ${MAX_UPLOAD_SIZE};

    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # JSON compressed here, not in the portal (#578): nginx does it in C, out of the API's event loop, and by type, so
    # PDFs and zips (already compressed) pass through as they are and downloads still stream. A guideline's tag map:
    # 16.9 MB, 2.7 MB gzipped. The portal never compresses, so nothing is compressed twice.
    gzip on;
    gzip_types application/json;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_vary on;

    location /api/ {
        proxy_pass ${PORTAL_API_UPSTREAM};
        proxy_set_header Host $host;
        # The caller, never what the caller claims: the peer's address, or behind proxies named in TRUSTED_PROXIES
        # the address they report (15-trusted-proxies.sh). One address, so the portal can't be handed a made-up one.
        proxy_set_header X-Forwarded-For $remote_addr;
        # Cloudflare's caller header only from cloudflared (TUNNEL_PROXIES), empty from anywhere else (#336)
        proxy_set_header CF-Connecting-IP $tunnel_caller;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Optional locations written at start-up: Grafana, when GRAFANA_UPSTREAM is set (16-grafana.sh, #397)
    include /etc/nginx/conf.d/locations/*.conf;

    # The build's id, which open pages compare when the person moves on (newBuild.tsx): never cached
    location = /build.json {
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'none'" always;
        try_files $uri =404;
    }

    location = /config.json {
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'none'" always;
        try_files $uri =404;
    }

    location /assets/ {
        # Vite output: scripts (including the pdf.js worker, an .mjs module) and styles
        types { text/javascript js mjs; text/css css; application/wasm wasm; image/svg+xml svg; }
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location /pdfjs/ {
        # pdf.js runtime data: WebAssembly decoders, CMaps, standard fonts, color profiles
        types { application/wasm wasm; text/javascript js mjs; font/ttf ttf; }
        default_type application/octet-stream;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri /index.html;
    }
}
