# Response headers when the web app is served by the Cloudflare Worker (deploy/cloudflare-worker). The nginx image
# sets the same headers itself and ignores this file. The API is on the same origin (the Worker forwards /api/).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
/index.html
  Cache-Control: no-cache
/config.json
  Cache-Control: no-store
/build.json
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/pdfjs/*
  Cache-Control: public, max-age=86400
